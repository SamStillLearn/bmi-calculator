<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefWidth="360.0" spacing="14.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bmi.gui.BMIController">
   <padding>
      <Insets bottom="24.0" left="28.0" right="28.0" top="24.0" />
   </padding>
   <children>
      <Label text="Kalkulator BMI">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <Label text="Berat badan (kg)" />
      <TextField fx:id="txtBerat" promptText="contoh: 65" />
      <Label text="Tinggi badan (cm)" />
      <TextField fx:id="txtTinggi" promptText="contoh: 170" />
      <HBox alignment="CENTER" spacing="12.0">
         <children>
            <Button defaultButton="true" mnemonicParsing="false" onAction="#onHitung" prefWidth="100.0" text="Hitung" />
            <Button mnemonicParsing="false" onAction="#onReset" prefWidth="100.0" text="Reset" />
         </children>
      </HBox>
      <Label fx:id="lblHasil" text="BMI: -">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <Label fx:id="lblKategori" wrapText="true" />
   </children>
</VBox>
